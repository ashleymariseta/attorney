# Core
DEBUG=True
SECRET_KEY=replace-me-with-a-secure-key
# Production: legalonline.co.zw,www.legalonline.co.zw,api.legalonline.co.zw
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Serve /media/ (avatars, KYC docs, POPs) via Django when DEBUG is off. Set to
# false only if a dedicated media server / CDN fronts /media/.
SERVE_MEDIA=True

# Datastores
DATABASE_URL=postgresql://attorney:attorney@db:5432/attorney
REDIS_URL=redis://redis:6379/0

# Frontend origins (comma-separated). CSRF_TRUSTED_ORIGINS also authorizes the
# WebSocket handshake, so it MUST include the web origin.
# Production: https://legalonline.co.zw,https://www.legalonline.co.zw
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI usage limits (per lawyer, on the shared admin-configured provider key).
# Platform defaults; per-user overrides live in the LLMUserQuota admin.
# Token quotas stack (day/week/month) — set any to 0 to disable that window.
LLM_POOL_DAILY_TOKEN_QUOTA=20000
LLM_POOL_WEEKLY_TOKEN_QUOTA=60000
LLM_POOL_MONTHLY_TOKEN_QUOTA=200000
LLM_POOL_RATE_LIMIT_PER_MINUTE=20

# AI provider (platform-wide shared key). Either configure an "AI Provider" row
# in Django admin, OR set the pool key here — the app falls back to this when no
# admin row exists. Leave blank to force admin configuration.
LLM_POOL_ANTHROPIC_API_KEY=
LLM_POOL_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
# Optional OpenAI / self-hosted pool keys (blank = disabled)
LLM_POOL_OPENAI_API_KEY=
LLM_POOL_OPENAI_BASE_URL=
LLM_POOL_OPENAI_DEFAULT_MODEL=gpt-4o
LLM_POOL_LOCAL_DEFAULT_MODEL=llama3.1

# Email — outbound transactional mail (verification, password reset, invites,
# 2FA codes, notifications). Defaults to console in dev; set SMTP creds for prod.
# For Google Workspace: host smtp.gmail.com, port 587, TLS, and a 16-char App
# Password (2-Step Verification must be on for that mailbox).
# NOTE: the sender/mailbox stays on the original Workspace domain
# (support@arttoney.com) even though the web app is now legalonline.co.zw.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Attorney <no-reply@attorney.local>

# Deep-link bases used inside emails (point these at your web app).
# Production: https://legalonline.co.zw/accept-invite (etc.)
INVITE_ACCEPT_URL=http://localhost:3000/accept-invite
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFY_URL=http://localhost:3000/verify-email
# Frontend origin used to make in-app links (e.g. /matters/12) absolute in
# emails. Defaults to the origin of INVITE_ACCEPT_URL, so usually leave unset.
# Production: https://legalonline.co.zw
# FRONTEND_URL=

# Sign in with Google — OAuth client IDs the backend accepts when verifying an
# ID token (web / Android / iOS). GOOGLE_ALLOWED_EMAIL_DOMAIN restricts sign-in
# to one Workspace domain; leave blank to allow any Google account.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_ALLOWED_EMAIL_DOMAIN=

# WhatsApp delivery for 2FA codes (blank = codes logged to console only)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
