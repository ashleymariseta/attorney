# Frontend (Next.js) public config. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.

# Base URL of the Django API.
# Production: https://api.legalonline.co.zw
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Public web app URL (used for absolute links / SEO).
# Production: https://legalonline.co.zw
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Google — the WEB OAuth client ID (same value as the backend's
# GOOGLE_OAUTH_WEB_CLIENT_ID). Add your web origin to the client's "Authorized
# JavaScript origins" in Google Cloud. Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
